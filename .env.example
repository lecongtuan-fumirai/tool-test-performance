# ==============================================================================
# KubePulse Platform - Production Environment Variables (Render / Cloud)
# ==============================================================================

# 1. Server & Network (Render tự động cấp PORT=10000)
PORT=10000
HOST=0.0.0.0
NODE_ENV=production

# 2. Bắt buộc: Khóa bảo mật mã hóa KubeConfig (AES-256-GCM)
# QUAN TRỌNG: Cần cố định biến này trên Render Dashboard để không bị mất quyền giải mã KubeConfig mỗi khi container restart.
# Tạo chuỗi ngẫu nhiên bằng lệnh: openssl rand -hex 32
ENCRYPTION_SECRET=4f9c8b7e2a1d6f3c0e5a9b8d7e6f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f

# 3. Tùy chọn (Chỉ cần nếu tách riêng Frontend thành Render Static Site độc lập)
# VITE_BACKEND_URL=https://your-kubepulse-backend.onrender.com
# VITE_WS_URL=wss://your-kubepulse-backend.onrender.com

