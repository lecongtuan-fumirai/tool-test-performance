{
  "name": "kubepulse-platform-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone OpenLens/Rancher-style Active Load & Security Verification Platform (Separated Frontend & Backend)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "dev:be": "pnpm --filter @kubepulse/backend run dev",
    "dev:fe": "pnpm --filter @kubepulse/frontend run dev",
    "build": "pnpm -r run build && node scripts/copy-frontend.js",
    "typecheck": "pnpm -r run typecheck",
    "start": "pnpm --filter @kubepulse/backend run start",
    "start:be": "pnpm --filter @kubepulse/backend run start"
  }
}
